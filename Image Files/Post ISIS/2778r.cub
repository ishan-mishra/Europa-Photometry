  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2019-04-16
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:32:38
  HostName          = Unknown
  UserName          = imishra
  Description       = "Import a Galileo solid state imager (SSI) image EDR
                       into Isis cube format"

  Group = UserParameters
    FROM      = "All data files/2778r.lbl"
    TO        = "All data files/Post ISIS/2778r.cub"
    FRAMEMODE = AUTO
  End_Group
End_Object
CCSD3ZF0000100000001NJPL3IF0PDS200000001 = SFDU_LABEL

/* File Format and Length */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 1000
FILE_RECORDS                             = 811

/* Pointers to Data Objects */
^IMAGE_HEADER                            = (2778R.IMG, 1)
^TELEMETRY_TABLE                         = (2778R.IMG, 3)
^BAD_DATA_VALUES_HEADER                  = (2778R.IMG, 5)
^IMAGE                                   = (2778R.IMG, 12)
^LINE_PREFIX_TABLE                       = (2778R.IMG, 12)

/* Description/Catalog Keywords */
DATA_SET_ID                              = GO-J/JSA-SSI-2-REDR-V1.0
SPACECRAFT_NAME                          = "GALILEO ORBITER"
INSTRUMENT_NAME                          = "SOLID STATE IMAGING SYSTEM"

/* Time tags and observation descriptors */
SPACECRAFT_CLOCK_CNT_PARTITION           = 1
SPACECRAFT_CLOCK_START_COUNT             = 04137427.78
IMAGE_TIME                               = 1997-09-19T12:35:55.621Z
IMAGE_ID                                 = 10E0001
ORBIT_NUMBER                             = 10
OBSERVATION_ID                           = 10ESGLOBAL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = 000T13:24:55Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = 000T07:14:51Z
NOTE                                     = "NOT APPLICABLE"

/* Camera and spacecraft state parameters */
FILTER_NAME                              = GREEN
FILTER_NUMBER                            = 1
EXPOSURE_DURATION                        = 45.83
GAIN_MODE_ID                             = 100K
FRAME_DURATION                           = 8.667
LIGHT_FLOOD_STATE_FLAG                   = ON
EXPOSURE_TYPE                            = NORMAL
BLEMISH_PROTECTION_FLAG                  = OFF
INVERTED_CLOCK_STATE_FLAG                = "NOT INVERTED"
ON_CHIP_MOSAIC_FLAG                      = N
COMPRESSION_TYPE                         = "INTEGER COSINE TRANSFORM"
ENTROPY                                  = 2.425
TELEMETRY_FORMAT_ID                      = IM8
OBSTRUCTION_ID                           = "NOT POSSIBLE"
INSTRUMENT_MODE_ID                       = N/A

/* Viewing Geometry                                           */
/* Note: These viewing geometry parameters are best estimates */
/* at the time this picture label was generated.              */
POSITIVE_LONGITUDE_DIRECTION             = WEST

/* Spacecraft Geometry */
TARGET_CENTER_DISTANCE                   = 7.247498e+05
CENTRAL_BODY_DISTANCE                    = 8.826138e+05
SUB_SPACECRAFT_LATITUDE                  = 0.098
SUB_SPACECRAFT_LONGITUDE                 = 282.567
SUB_SPACECRAFT_LINE                      = 250.767
SUB_SPACECRAFT_LINE_SAMPLE               = 646.642
SUB_SPACECRAFT_AZIMUTH                   = 148.824

/* Camera and Lighting Geometry                                  */
/* Resolution of HORIZONTAL_PIXEL_SCALE,                         */
/* VERTICAL_PIXEL_SCALE, and SLANT_DISTANCE                      */
/* is calculated from the light source values in                 */
/* INTERCEPT_POINT_LATITUDE, INTERCEPT_POINT_LONGITUDE,          */
/* INTERCEPT_POINT_LINE and INTERCEPT_POINT_LINE_SAMPLE keywords */
/* If the target is a Ring keyword RING_RADIUS                   */
/* is substituted for INTERCEPT_POINT_LATITUDE                   */
/* If the TARGET_NAME = J RINGS, viewing geometry was            */
/* calculated using Jupiter as the target.                       */
TWIST_ANGLE                              = 291.537
CONE_ANGLE                               = 173.818
RIGHT_ASCENSION                          = 348.378
DECLINATION                              = -4.483
NORTH_AZIMUTH                            = 273.225
SMEAR_AZIMUTH                            = UNK
SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 7.340490e+03
VERTICAL_PIXEL_SCALE                     = 7.342790e+03
SLANT_DISTANCE                           = 7.231850e+05
SOLAR_DISTANCE                           = 7.559230e+08
SUB_SOLAR_LATITUDE                       = 0.601
SUB_SOLAR_LONGITUDE                      = 309.430
SUB_SOLAR_AZIMUTH                        = 184.361
INCIDENCE_ANGLE                          = 26.867
EMISSION_ANGLE                           = 0.000
PHASE_ANGLE                              = 26.867
LOCAL_HOUR_ANGLE                         = 206.863
INTERCEPT_POINT_LATITUDE                 = 0.098
INTERCEPT_POINT_LONGITUDE                = 282.567
INTERCEPT_POINT_LINE                     = 250.7
INTERCEPT_POINT_LINE_SAMPLE              = 646.8

/* Target radii */
A_AXIS_RADIUS                            = 1.565000e+03
B_AXIS_RADIUS                            = 1.565000e+03
C_AXIS_RADIUS                            = 1.565000e+03

/* Processing parameters */
MEAN_RADIANCE                            = N/A
MEAN_REFLECTANCE                         = N/A
REFLECTANCE_SCALING_FACTOR               = N/A
RADIANCE_SCALING_FACTOR                  = N/A
UNEVEN_BIT_WEIGHT_CORR_FLAG              = N/A
DARK_CURRENT_FILE_NAME                   = N/A
SLOPE_FILE_NAME                          = N/A
BLEMISH_FILE_NAME                        = N/A
SHUTTER_OFFSET_FILE_NAME                 = N/A
DATA_TYPE                                = LSB_UNSIGNED_INTEGER
SOURCE_PRODUCT_ID                        = (S980127A.BSP, S980127A.BSP, N/A,
                                            CKC10AOD.PLT, NULL)
PROCESSING_HISTORY_TEXT                  = "VICAR programs run:
                                            SSIMERGE,CATLABEL,BADLABELS."
PRODUCT_TYPE                             = REDR

/* ICT or Lossless compression */
ENCODING_COMPRESSION_RATIO               = 5.090
ENCODING_MIN_COMPRESSION_RATIO           = 3.261
ENCODING_MAX_COMPRESSION_RATIO           = 22.911
HUFFMAN_TABLE_TYPE                       = SKEWED
ICT_DESPIKE_THRESHOLD                    = 255
CUT_OUT_WINDOW                           = (1, 105, 584, 696)
TRUTH_WINDOW                             = (801, 801, 96, 96)
PRODUCT_VERSION_ID                       = 0
ICT_QUANTIZATION_STEP_SIZE               = 2
ICT_ZIGZAG_PATTERN                       = ZIGZAG
CMPRS_QUANTZ_TBL_ID                      = UNIFORM

/* VICAR IMAGE HEADER Object */
Object = IMAGE_HEADER
  INTERCHANGE_FORMAT = BINARY
  HEADER_TYPE        = VICAR2
  BYTES              = 2000
  RECORDS            = 2
  ^DESCRIPTION       = VICAR2.TXT
End_Object

/* Table Object (for telemetry table) */
Object = TELEMETRY_TABLE
  INTERCHANGE_FORMAT = BINARY
  ROWS               = 1
  COLUMNS            = 86
  ROW_BYTES          = 1800
  ^STRUCTURE         = RTLMTAB.FMT
End_Object

/* Bad Data Value Header Object */
Object = BAD_DATA_VALUES_HEADER
  HEADER_TYPE        = BDV
  INTERCHANGE_FORMAT = BINARY
  BYTES              = 7000
  RECORDS            = 7
  ^DESCRIPTION       = BADDATA.TXT
End_Object

/* Image Object */
Object = IMAGE
  LINES                  = 800
  LINE_SAMPLES           = 800
  SAMPLE_BITS            = 8
  SAMPLE_TYPE            = UNSIGNED_INTEGER
  INVALID_CONSTANT       = N/A
  LINE_PREFIX_BYTES      = 200
  ^LINE_PREFIX_STRUCTURE = RLINEPRX.FMT
End_Object
