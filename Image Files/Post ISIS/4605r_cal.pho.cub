/* File Format and Length */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 1000
FILE_RECORDS                             = 812

/* Pointers to Data Objects */
^IMAGE_HEADER                            = (4605R.IMG, 1)
^TELEMETRY_TABLE                         = (4605R.IMG, 3)
^BAD_DATA_VALUES_HEADER                  = (4605R.IMG, 5)
^IMAGE                                   = (4605R.IMG, 13)
^LINE_PREFIX_TABLE                       = (4605R.IMG, 13)

/* Description/Catalog Keywords */
DATA_SET_ID                              = GO-J/JSA-SSI-2-REDR-V1.0
SPACECRAFT_NAME                          = "GALILEO ORBITER"
INSTRUMENT_NAME                          = "SOLID STATE IMAGING SYSTEM"

/* Time tags and observation descriptors */
SPACECRAFT_CLOCK_CNT_PARTITION           = 1
SPACECRAFT_CLOCK_START_COUNT             = 03836946.05
IMAGE_TIME                               = 1997-02-20T12:55:36.922Z
IMAGE_ID                                 = E6E0002
ORBIT_NUMBER                             = 6
OBSERVATION_ID                           = E6ESGLOBAL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = -000T07:59:24Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = -000T04:11:24Z
NOTE                                     = "NOT APPLICABLE"

/* Camera and spacecraft state parameters */
FILTER_NAME                              = CLEAR
FILTER_NUMBER                            = 0
EXPOSURE_DURATION                        = 6.25
GAIN_MODE_ID                             = 400K
FRAME_DURATION                           = 2.333
LIGHT_FLOOD_STATE_FLAG                   = OFF
EXPOSURE_TYPE                            = NORMAL
BLEMISH_PROTECTION_FLAG                  = OFF
INVERTED_CLOCK_STATE_FLAG                = "NOT INVERTED"
ON_CHIP_MOSAIC_FLAG                      = N
COMPRESSION_TYPE                         = "INTEGER COSINE TRANSFORM"
ENTROPY                                  = 3.981
TELEMETRY_FORMAT_ID                      = AI8
OBSTRUCTION_ID                           = "NOT POSSIBLE"
INSTRUMENT_MODE_ID                       = N/A

/* Viewing Geometry                                           */
/* Note: These viewing geometry parameters are best estimates */
/* at the time this picture label was generated.              */
POSITIVE_LONGITUDE_DIRECTION             = WEST

/* Spacecraft Geometry */
TARGET_CENTER_DISTANCE                   = 8.325098e+04
CENTRAL_BODY_DISTANCE                    = 7.477787e+05
SUB_SPACECRAFT_LATITUDE                  = -0.508
SUB_SPACECRAFT_LONGITUDE                 = 215.185
SUB_SPACECRAFT_LINE                      = 809.553
SUB_SPACECRAFT_LINE_SAMPLE               = 251.972
SUB_SPACECRAFT_AZIMUTH                   = 85.127

/* Camera and Lighting Geometry                                  */
/* Resolution of HORIZONTAL_PIXEL_SCALE,                         */
/* VERTICAL_PIXEL_SCALE, and SLANT_DISTANCE                      */
/* is calculated from the light source values in                 */
/* INTERCEPT_POINT_LATITUDE, INTERCEPT_POINT_LONGITUDE,          */
/* INTERCEPT_POINT_LINE and INTERCEPT_POINT_LINE_SAMPLE keywords */
/* If the target is a Ring keyword RING_RADIUS                   */
/* is substituted for INTERCEPT_POINT_LATITUDE                   */
/* If the TARGET_NAME = J RINGS, viewing geometry was            */
/* calculated using Jupiter as the target.                       */
TWIST_ANGLE                              = 89.305
CONE_ANGLE                               = 137.816
RIGHT_ASCENSION                          = 265.676
DECLINATION                              = -25.328
NORTH_AZIMUTH                            = 89.944
SMEAR_AZIMUTH                            = UNK
SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 1.671110e+03
VERTICAL_PIXEL_SCALE                     = 2.215420e+03
SLANT_DISTANCE                           = 8.206840e+04
SOLAR_DISTANCE                           = 7.651870e+08
SUB_SOLAR_LATITUDE                       = -0.351
SUB_SOLAR_LONGITUDE                      = 179.022
SUB_SOLAR_AZIMUTH                        = 143.153
INCIDENCE_ANGLE                          = 49.895
EMISSION_ANGLE                           = 41.358
PHASE_ANGLE                              = 36.226
LOCAL_HOUR_ANGLE                         = 135.094
INTERCEPT_POINT_LATITUDE                 = -40.979
INTERCEPT_POINT_LONGITUDE                = 211.030
INTERCEPT_POINT_LINE                     = 200.0
INTERCEPT_POINT_LINE_SAMPLE              = 200.0

/* Target radii */
A_AXIS_RADIUS                            = 1.565000e+03
B_AXIS_RADIUS                            = 1.565000e+03
C_AXIS_RADIUS                            = 1.565000e+03

/* Processing parameters */
MEAN_RADIANCE                            = N/A
MEAN_REFLECTANCE                         = N/A
REFLECTANCE_SCALING_FACTOR               = N/A
RADIANCE_SCALING_FACTOR                  = N/A
UNEVEN_BIT_WEIGHT_CORR_FLAG              = N/A
DARK_CURRENT_FILE_NAME                   = N/A
SLOPE_FILE_NAME                          = N/A
BLEMISH_FILE_NAME                        = N/A
SHUTTER_OFFSET_FILE_NAME                 = N/A
DATA_TYPE                                = LSB_UNSIGNED_INTEGER
SOURCE_PRODUCT_ID                        = (S980127A.BSP, S980127A.BSP, N/A,
                                            CKE06APE.PLT, NULL)
PROCESSING_HISTORY_TEXT                  = "VICAR programs run:
                                            SSIMERGE,CATLABEL,BADLABELS."
PRODUCT_TYPE                             = REDR

/* ICT or Lossless compression */
ENCODING_COMPRESSION_RATIO               = 2.793
ENCODING_MIN_COMPRESSION_RATIO           = 1.760
ENCODING_MAX_COMPRESSION_RATIO           = 3.908
HUFFMAN_TABLE_TYPE                       = SKEWED
ICT_DESPIKE_THRESHOLD                    = 255
CUT_OUT_WINDOW                           = (1, 17, 400, 384)
TRUTH_WINDOW                             = (801, 801, 96, 96)
PRODUCT_VERSION_ID                       = 1
ICT_QUANTIZATION_STEP_SIZE               = 3
ICT_ZIGZAG_PATTERN                       = ZIGZAG
CMPRS_QUANTZ_TBL_ID                      = UNIFORM

/* VICAR IMAGE HEADER Object */
Object = IMAGE_HEADER
  INTERCHANGE_FORMAT = BINARY
  HEADER_TYPE        = VICAR2
  BYTES              = 2000
  RECORDS            = 2
  ^DESCRIPTION       = VICAR2.TXT
End_Object

/* Table Object (for telemetry table) */
Object = TELEMETRY_TABLE
  INTERCHANGE_FORMAT = BINARY
  ROWS               = 1
  COLUMNS            = 86
  ROW_BYTES          = 1800
  ^STRUCTURE         = RTLMTAB.FMT
End_Object

/* Bad Data Value Header Object */
Object = BAD_DATA_VALUES_HEADER
  HEADER_TYPE        = BDV
  INTERCHANGE_FORMAT = BINARY
  BYTES              = 8000
  RECORDS            = 8
  ^DESCRIPTION       = BADDATA.TXT
End_Object

/* Image Object */
Object = IMAGE
  LINES                  = 800
  LINE_SAMPLES           = 800
  SAMPLE_BITS            = 8
  SAMPLE_TYPE            = UNSIGNED_INTEGER
  INVALID_CONSTANT       = N/A
  LINE_PREFIX_BYTES      = 200
  ^LINE_PREFIX_STRUCTURE = RLINEPRX.FMT
End_Object
EndObject = spiceinit
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-08-10
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:32:52
  HostName          = Unknown
  UserName          = imishra
  Description       = "Update SPICE data (kernels, pointing, and position) for
                       a camera cube"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/4605r.cub"
    WEB          = false
    ATTACH       = TRUE
    CKSMITHED    = FALSE
    CKRECON      = TRUE
    CKPREDICTED  = FALSE
    CKNADIR      = FALSE
    SPKSMITHED   = FALSE
    SPKRECON     = TRUE
    SPKPREDICTED = FALSE
    SHAPE        = SYSTEM
    STARTPAD     = 0.0
    ENDPAD       = 0.0
    URL          = https://services.isis.astrogeology.usgs.gov/cgi-bin/spicei-
                   nit.cgi
    PORT         = 443
  End_Group
End_Object

Object = gllssical
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-02-23
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:32:54
  HostName          = Unknown
  UserName          = imishra
  Description       = "Perform Radiometric correction on GALILEO-SSI Imaging"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/4605r.cub"
    TO           = "All data files/Post ISIS/4605r_cal.cub"
    UNITS        = IOF
    SCALE        = 1.0
    BITWEIGHTING = false
  End_Group
End_Object

Object = phocube
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-06-01
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:32:54
  HostName          = Unknown
  UserName          = imishra
  Description       = "Create photometric and geometric information bands for
                       an image cube"

  Group = UserParameters
    FROM                       = "All data files/Post ISIS/4605r_cal.cub"
    TO                         = "All data files/Post ISIS/4605r_cal.pho.cub"
    SOURCE                     = CAMERA
    SPECIALPIXELS              = TRUE
    DN                         = yes
    ALLDNS                     = FALSE
    PHASE                      = yes
    EMISSION                   = yes
    INCIDENCE                  = yes
    LOCALEMISSION              = FALSE
    LOCALINCIDENCE             = FALSE
    LATITUDE                   = yes
    LONGITUDE                  = yes
    PIXELRESOLUTION            = yes
    LINERESOLUTION             = FALSE
    SAMPLERESOLUTION           = FALSE
    DETECTORRESOLUTION         = FALSE
    OBLIQUEDETECTORRESOLUTION  = FALSE
    NORTHAZIMUTH               = FALSE
    SUNAZIMUTH                 = FALSE
    SPACECRAFTAZIMUTH          = FALSE
    OFFNADIRANGLE              = FALSE
    SLOPE                      = FALSE
    LOCALNORMAL                = FALSE
    ELLIPSOIDNORMAL            = FALSE
    SUBSPACECRAFTGROUNDAZIMUTH = FALSE
    SUBSOLARGROUNDAZIMUTH      = FALSE
    MORPHOLOGYRANK             = FALSE
    ALBEDORANK                 = FALSE
    RADEC                      = FALSE
    BODYFIXED                  = FALSE
    LOCALTIME                  = FALSE
  End_Group
End_Object
