/* File Format and Length */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 1000
FILE_RECORDS                             = 812

/* Pointers to Data Objects */
^IMAGE_HEADER                            = (4605R.IMG, 1)
^TELEMETRY_TABLE                         = (4605R.IMG, 3)
^BAD_DATA_VALUES_HEADER                  = (4605R.IMG, 5)
^IMAGE                                   = (4605R.IMG, 13)
^LINE_PREFIX_TABLE                       = (4605R.IMG, 13)

/* Description/Catalog Keywords */
DATA_SET_ID                              = GO-J/JSA-SSI-2-REDR-V1.0
SPACECRAFT_NAME                          = "GALILEO ORBITER"
INSTRUMENT_NAME                          = "SOLID STATE IMAGING SYSTEM"

/* Time tags and observation descriptors */
SPACECRAFT_CLOCK_CNT_PARTITION           = 1
SPACECRAFT_CLOCK_START_COUNT             = 03836946.05
IMAGE_TIME                               = 1997-02-20T12:55:36.922Z
IMAGE_ID                                 = E6E0002
ORBIT_NUMBER                             = 6
OBSERVATION_ID                           = E6ESGLOBAL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = -000T07:59:24Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = -000T04:11:24Z
NOTE                                     = "NOT APPLICABLE"

/* Camera and spacecraft state parameters */
FILTER_NAME                              = CLEAR
FILTER_NUMBER                            = 0
EXPOSURE_DURATION                        = 6.25
GAIN_MODE_ID                             = 400K
FRAME_DURATION                           = 2.333
LIGHT_FLOOD_STATE_FLAG                   = OFF
EXPOSURE_TYPE                            = NORMAL
BLEMISH_PROTECTION_FLAG                  = OFF
INVERTED_CLOCK_STATE_FLAG                = "NOT INVERTED"
ON_CHIP_MOSAIC_FLAG                      = N
COMPRESSION_TYPE                         = "INTEGER COSINE TRANSFORM"
ENTROPY                                  = 3.981
TELEMETRY_FORMAT_ID                      = AI8
OBSTRUCTION_ID                           = "NOT POSSIBLE"
INSTRUMENT_MODE_ID                       = N/A

/* Viewing Geometry                                           */
/* Note: These viewing geometry parameters are best estimates */
/* at the time this picture label was generated.              */
POSITIVE_LONGITUDE_DIRECTION             = WEST

/* Spacecraft Geometry */
TARGET_CENTER_DISTANCE                   = 8.325098e+04
CENTRAL_BODY_DISTANCE                    = 7.477787e+05
SUB_SPACECRAFT_LATITUDE                  = -0.508
SUB_SPACECRAFT_LONGITUDE                 = 215.185
SUB_SPACECRAFT_LINE                      = 809.553
SUB_SPACECRAFT_LINE_SAMPLE               = 251.972
SUB_SPACECRAFT_AZIMUTH                   = 85.127

/* Camera and Lighting Geometry                                  */
/* Resolution of HORIZONTAL_PIXEL_SCALE,                         */
/* VERTICAL_PIXEL_SCALE, and SLANT_DISTANCE                      */
/* is calculated from the light source values in                 */
/* INTERCEPT_POINT_LATITUDE, INTERCEPT_POINT_LONGITUDE,          */
/* INTERCEPT_POINT_LINE and INTERCEPT_POINT_LINE_SAMPLE keywords */
/* If the target is a Ring keyword RING_RADIUS                   */
/* is substituted for INTERCEPT_POINT_LATITUDE                   */
/* If the TARGET_NAME = J RINGS, viewing geometry was            */
/* calculated using Jupiter as the target.                       */
TWIST_ANGLE                              = 89.305
CONE_ANGLE                               = 137.816
RIGHT_ASCENSION                          = 265.676
DECLINATION                              = -25.328
NORTH_AZIMUTH                            = 89.944
SMEAR_AZIMUTH                            = UNK
SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 1.671110e+03
VERTICAL_PIXEL_SCALE                     = 2.215420e+03
SLANT_DISTANCE                           = 8.206840e+04
SOLAR_DISTANCE                           = 7.651870e+08
SUB_SOLAR_LATITUDE                       = -0.351
SUB_SOLAR_LONGITUDE                      = 179.022
SUB_SOLAR_AZIMUTH                        = 143.153
INCIDENCE_ANGLE                          = 49.895
EMISSION_ANGLE                           = 41.358
PHASE_ANGLE                              = 36.226
LOCAL_HOUR_ANGLE                         = 135.094
INTERCEPT_POINT_LATITUDE                 = -40.979
INTERCEPT_POINT_LONGITUDE                = 211.030
INTERCEPT_POINT_LINE                     = 200.0
INTERCEPT_POINT_LINE_SAMPLE              = 200.0

/* Target radii */
A_AXIS_RADIUS                            = 1.565000e+03
B_AXIS_RADIUS                            = 1.565000e+03
C_AXIS_RADIUS                            = 1.565000e+03

/* Processing parameters */
MEAN_RADIANCE                            = N/A
MEAN_REFLECTANCE                         = N/A
REFLECTANCE_SCALING_FACTOR               = N/A
RADIANCE_SCALING_FACTOR                  = N/A
UNEVEN_BIT_WEIGHT_CORR_FLAG              = N/A
DARK_CURRENT_FILE_NAME                   = N/A
SLOPE_FILE_NAME                          = N/A
