OBSERVATION_ID                           = 14ESGLOCOL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = 000T11:23:30Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = 000T06:01:30Z
