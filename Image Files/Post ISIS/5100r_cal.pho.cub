@”c˜dÍjšÁCCSD3ZF0000100000001NJPL3IF0PDS200000001 = SFDU_LABEL

/* File Format and Length */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 1000
FILE_RECORDS                             = 806

/* Pointers to Data Objects */
^IMAGE_HEADER                            = (5100R.IMG, 1)
^TELEMETRY_TABLE                         = (5100R.IMG, 3)
^BAD_DATA_VALUES_HEADER                  = (5100R.IMG, 5)
^IMAGE                                   = (5100R.IMG, 7)
^LINE_PREFIX_TABLE                       = (5100R.IMG, 7)

/* Description/Catalog Keywords */
DATA_SET_ID                              = GO-J/JSA-SSI-2-REDR-V1.0
SPACECRAFT_NAME                          = "GALILEO ORBITER"
INSTRUMENT_NAME                          = "SOLID STATE IMAGING SYSTEM"

/* Time tags and observation descriptors */
SPACECRAFT_CLOCK_CNT_PARTITION           = 1
SPACECRAFT_CLOCK_START_COUNT             = 03498751.00
IMAGE_TIME                               = 1996-06-28T01:43:04.667Z
IMAGE_ID                                 = G1E0001
ORBIT_NUMBER                             = 1
OBSERVATION_ID                           = G1ESGLOBAL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = 000T01:11:02Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = 000T00:20:02Z
NOTE                                     = "NOT APPLICABLE"

/* Camera and spacecraft state parameters */
FILTER_NAME                              = CLEAR
FILTER_NUMBER                            = 0
EXPOSURE_DURATION                        = 4.17
GAIN_MODE_ID                             = 100K
FRAME_DURATION                           = 8.667
LIGHT_FLOOD_STATE_FLAG                   = ON
EXPOSURE_TYPE                            = NORMAL
BLEMISH_PROTECTION_FLAG                  = OFF
INVERTED_CLOCK_STATE_FLAG                = "NOT INVERTED"
ON_CHIP_MOSAIC_FLAG                      = N
COMPRESSION_TYPE                         = "BARC RATE CONTROL"
ENTROPY                                  = 2.608
TELEMETRY_FORMAT_ID                      = IM4
MEAN_TRUNCATED_BITS                      = 0.022
MEAN_TRUNCATED_SAMPLES                   = 0.198
OBSTRUCTION_ID                           = "NOT POSSIBLE"
INSTRUMENT_MODE_ID                       = N/A

/* Viewing Geometry                                           */
/* Note: These viewing geometry parameters are best estimates */
/* at the time this picture label was generated.              */
POSITIVE_LONGITUDE_DIRECTION             = WEST

/* Spacecraft Geometry */
TARGET_CENTER_DISTANCE                   = 1.561595e+05
CENTRAL_BODY_DISTANCE                    = 7.902163e+05
SUB_SPACECRAFT_LATITUDE                  = 23.862
SUB_SPACECRAFT_LONGITUDE                 = 217.368
SUB_SPACECRAFT_LINE                      = 787.162
SUB_SPACECRAFT_LINE_SAMPLE               = 10.683
SUB_SPACECRAFT_AZIMUTH                   = 315.159

/* Camera and Lighting Geometry                                  */
/* Resolution of HORIZONTAL_PIXEL_SCALE,                         */
/* VERTICAL_PIXEL_SCALE, and SLANT_DISTANCE                      */
/* is calculated from the light source values in                 */
/* INTERCEPT_POINT_LATITUDE, INTERCEPT_POINT_LONGITUDE,          */
/* INTERCEPT_POINT_LINE and INTERCEPT_POINT_LINE_SAMPLE keywords */
/* If the target is a Ring keyword RING_RADIUS                   */
/* is substituted for INTERCEPT_POINT_LATITUDE                   */
/* If the TARGET_NAME = J RINGS, viewing geometry was            */
/* calculated using Jupiter as the target.                       */
TWIST_ANGLE                              = 256.518
CONE_ANGLE                               = 144.097
RIGHT_ASCENSION                          = 322.579
DECLINATION                              = -40.242
NORTH_AZIMUTH                            = 305.896
SMEAR_AZIMUTH                            = UNK
SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 1.569620e+03
VERTICAL_PIXEL_SCALE                     = 1.569520e+03
SLANT_DISTANCE                           = 1.545950e+05
SOLAR_DISTANCE                           = 7.784370e+08
SUB_SOLAR_LATITUDE                       = -1.395
SUB_SOLAR_LONGITUDE                      = 245.910
SUB_SOLAR_AZIMUTH                        = 177.551
INCIDENCE_ANGLE                          = 37.505
EMISSION_ANGLE                           = 0.000
PHASE_ANGLE                              = 37.505
LOCAL_HOUR_ANGLE                         = 208.412
INTERCEPT_POINT_LATITUDE                 = 23.862
INTERCEPT_POINT_LONGITUDE                = 217.368
INTERCEPT_POINT_LINE                     = 787.2
INTERCEPT_POINT_LINE_SAMPLE              = 10.7

/* Target radii */
A_AXIS_RADIUS                            = 1.565000e+03
B_AXIS_RADIUS                            = 1.565000e+03
C_AXIS_RADIUS                            = 1.565000e+03

/* Processing parameters */
MEAN_RADIANCE                            = N/A
MEAN_REFLECTANCE                         = N/A
REFLECTANCE_SCALING_FACTOR               = N/A
RADIANCE_SCALING_FACTOR                  = N/A
UNEVEN_BIT_WEIGHT_CORR_FLAG              = N/A
DARK_CURRENT_FILE_NAME                   = N/A
SLOPE_FILE_NAME                          = N/A
BLEMISH_FILE_NAME                        = N/A
SHUTTER_OFFSET_FILE_NAME                 = N/A
DATA_TYPE                                = LSB_UNSIGNED_INTEGER
SOURCE_PRODUCT_ID                        = (S971016A.BSP, S971016A.BSP, N/A,
                                            CKG01B.PLT,
                                            "SSI_SNI
                                            P.G01AJHV14_MOD_FIXED_PICNOS")
PROCESSING_HISTORY_TEXT                  = "VICAR programs run:
                                            SSIMERGE,CATLABEL,BADLABELS."
PRODUCT_TYPE                             = REDR

/* BARC Encoding */
CUT_OUT_WINDOW                           = (1, 1, 728, 800)

/* VICAR IMAGE HEADER Object */
Object = IMAGE_HEADER
  INTERCHANGE_FORMAT = BINARY
  HEADER_TYPE        = VICAR2
  BYTES              = 2000
  RECORDS            = 2
  ^DESCRIPTION       = VICAR2.TXT
End_Object

/* Table Object (for telemetry table) */
Object = TELEMETRY_TABLE
  INTERCHANGE_FORMAT = BINARY
  ROWS               = 1
  COLUMNS            = 86
  ROW_BYTES          = 1800
  ^STRUCTURE         = RTLMTAB.FMT
End_Object

/* Bad Data Value Header Object */
Object = BAD_DATA_VALUES_HEADER
  HEADER_TYPE        = BDV
  INTERCHANGE_FORMAT = BINARY
  BYTES              = 2000
  RECORDS            = 2
  ^DESCRIPTION       = BADDATA.TXT
End_Object

/* Image Object */
Object = IMAGE
  LINES                  = 800
  LINE_SAMPLES           = 800
  SAMPLE_BITS            = 8
  SAMPLE_TYPE            = UNSIGNED_INTEGER
  INVALID_CONSTANT       = N/A
  LINE_PREFIX_BYTES      = 200
  ^LINE_PREFIX_STRUCTURE = RLINEPRX.FMT
End_Object
EndObject = gllssi2isis
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2019-04-16
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:06
  HostName          = Unknown
  UserName          = imishra
  Description       = "Import a Galileo solid state imager (SSI) image EDR
                       into Isis cube format"

  Group = UserParameters
    FROM      = "All data files/5100r.lbl"
    TO        = "All data files/Post ISIS/5100r.cub"
    FRAMEMODE = AUTO
  End_Group
End_Object

Object = spiceinit
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-08-10
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:07
  HostName          = Unknown
  UserName          = imishra
  Description       = "Update SPICE data (kernels, pointing, and position) for
                       a camera cube"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/5100r.cub"
    WEB          = false
    ATTACH       = TRUE
    CKSMITHED    = FALSE
    CKRECON      = TRUE
    CKPREDICTED  = FALSE
    CKNADIR      = FALSE
    SPKSMITHED   = FALSE
    SPKRECON     = TRUE
    SPKPREDICTED = FALSE
    SHAPE        = SYSTEM
    STARTPAD     = 0.0
    ENDPAD       = 0.0
    URL          = https://services.isis.astrogeology.usgs.gov/cgi-bin/spicei-
                   nit.cgi
    PORT         = 443
  End_Group
End_Object

Object = gllssical
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-02-23
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:09
  HostName          = Unknown
  UserName          = imishra
  Description       = "Perform Radiometric correction on GALILEO-SSI Imaging"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/5100r.cub"
    TO           = "All data files/Post ISIS/5100r_cal.cub"
    UNITS        = IOF
    SCALE        = 1.0
    BITWEIGHTING = false
  End_Group
End_Object

Object = phocube
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-06-01
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:10
  HostName          = Unknown
  UserName          = imishra
  Description       = "Create photometric and geometric information bands for
                       an image cube"

  Group = UserParameters
    FROM                       = "All data files/Post ISIS/5100r_cal.cub"
    TO                         = "All data files/Post ISIS/5100r_cal.pho.cub"
    SOURCE                     = CAMERA
    SPECIALPIXELS              = TRUE
    DN                         = yes
    ALLDNS                     = FALSE
    PHASE                      = yes
    EMISSION                   = yes
    INCIDENCE                  = yes
    LOCALEMISSION              = FALSE
    LOCALINCIDENCE             = FALSE
    LATITUDE                   = yes
    LONGITUDE                  = yes
    PIXELRESOLUTION            = yes
    LINERESOLUTION             = FALSE
    SAMPLERESOLUTION           = FALSE
    DETECTORRESOLUTION         = FALSE
    OBLIQUEDETECTORRESOLUTION  = FALSE
    NORTHAZIMUTH               = FALSE
    SUNAZIMUTH                 = FALSE
    SPACECRAFTAZIMUTH          = FALSE
    OFFNADIRANGLE              = FALSE
    SLOPE                      = FALSE
    LOCALNORMAL                = FALSE
    ELLIPSOIDNORMAL            = FALSE
    SUBSPACECRAFTGROUNDAZIMUTH = FALSE
    SUBSOLARGROUNDAZIMUTH      = FALSE
    MORPHOLOGYRANK             = FALSE
    ALBEDORANK                 = FALSE
    RADEC                      = FALSE
    BODYFIXED                  = FALSE
    LOCALTIME                  = FALSE
  End_Group
End_Object
