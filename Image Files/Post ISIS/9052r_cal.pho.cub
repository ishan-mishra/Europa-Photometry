SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 1.268410e+03
VERTICAL_PIXEL_SCALE                     = 1.410140e+03
SLANT_DISTANCE                           = 1.200780e+05
SOLAR_DISTANCE                           = 7.687530e+08
SUB_SOLAR_LATITUDE                       = -0.638
SUB_SOLAR_LONGITUDE                      = 225.737
SUB_SOLAR_AZIMUTH                        = 189.365
INCIDENCE_ANGLE                          = 74.416
EMISSION_ANGLE                           = 32.929
PHASE_ANGLE                              = 55.539
LOCAL_HOUR_ANGLE                         = 108.405
INTERCEPT_POINT_LATITUDE                 = 28.537
INTERCEPT_POINT_LONGITUDE                = 297.564
INTERCEPT_POINT_LINE                     = 400.0
INTERCEPT_POINT_LINE_SAMPLE              = 400.0

/* Target radii */
