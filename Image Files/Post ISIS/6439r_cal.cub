/* File Format and Length */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 1000
FILE_RECORDS                             = 812

/* Pointers to Data Objects */
^IMAGE_HEADER                            = (6439R.IMG, 1)
^TELEMETRY_TABLE                         = (6439R.IMG, 3)
^BAD_DATA_VALUES_HEADER                  = (6439R.IMG, 5)
^IMAGE                                   = (6439R.IMG, 13)
^LINE_PREFIX_TABLE                       = (6439R.IMG, 13)

/* Description/Catalog Keywords */
DATA_SET_ID                              = GO-J/JSA-SSI-2-REDR-V1.0
SPACECRAFT_NAME                          = "GALILEO ORBITER"
INSTRUMENT_NAME                          = "SOLID STATE IMAGING SYSTEM"

/* Time tags and observation descriptors */
SPACECRAFT_CLOCK_CNT_PARTITION           = 1
SPACECRAFT_CLOCK_START_COUNT             = 05272864.39
IMAGE_TIME                               = 1999-11-25T18:47:46.845Z
IMAGE_ID                                 = 25E0030
ORBIT_NUMBER                             = 25
OBSERVATION_ID                           = 25ESGLOBAL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = -000T07:21:14Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = 000T02:19:41Z
NOTE                                     = "NOT APPLICABLE"

/* Camera and spacecraft state parameters */
FILTER_NAME                              = CLEAR
FILTER_NUMBER                            = 0
EXPOSURE_DURATION                        = 12.50
GAIN_MODE_ID                             = 100K
FRAME_DURATION                           = 8.667
LIGHT_FLOOD_STATE_FLAG                   = ON
EXPOSURE_TYPE                            = NORMAL
BLEMISH_PROTECTION_FLAG                  = OFF
INVERTED_CLOCK_STATE_FLAG                = "NOT INVERTED"
ON_CHIP_MOSAIC_FLAG                      = N
COMPRESSION_TYPE                         = "INTEGER COSINE TRANSFORM"
ENTROPY                                  = 4.757
TELEMETRY_FORMAT_ID                      = IM8
OBSTRUCTION_ID                           = "NOT POSSIBLE"
INSTRUMENT_MODE_ID                       = N/A

/* Viewing Geometry                                           */
/* Note: These viewing geometry parameters are best estimates */
/* at the time this picture label was generated.              */
POSITIVE_LONGITUDE_DIRECTION             = WEST

/* Spacecraft Geometry */
TARGET_CENTER_DISTANCE                   = 9.651423e+04
CENTRAL_BODY_DISTANCE                    = 5.856412e+05
SUB_SPACECRAFT_LATITUDE                  = 4.317
SUB_SPACECRAFT_LONGITUDE                 = 17.983
SUB_SPACECRAFT_LINE                      = 362.271
SUB_SPACECRAFT_LINE_SAMPLE               = -604.871
SUB_SPACECRAFT_AZIMUTH                   = 182.150

/* Camera and Lighting Geometry                                  */
/* Resolution of HORIZONTAL_PIXEL_SCALE,                         */
/* VERTICAL_PIXEL_SCALE, and SLANT_DISTANCE                      */
/* is calculated from the light source values in                 */
/* INTERCEPT_POINT_LATITUDE, INTERCEPT_POINT_LONGITUDE,          */
/* INTERCEPT_POINT_LINE and INTERCEPT_POINT_LINE_SAMPLE keywords */
/* If the target is a Ring keyword RING_RADIUS                   */
/* is substituted for INTERCEPT_POINT_LATITUDE                   */
/* If the TARGET_NAME = J RINGS, viewing geometry was            */
/* calculated using Jupiter as the target.                       */
TWIST_ANGLE                              = 279.873
CONE_ANGLE                               = 132.505
RIGHT_ASCENSION                          = 72.181
DECLINATION                              = 19.798
NORTH_AZIMUTH                            = 266.779
SMEAR_AZIMUTH                            = UNK
SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 1.245580e+03
VERTICAL_PIXEL_SCALE                     = 9.679780e+02
SLANT_DISTANCE                           = 9.529340e+04
SOLAR_DISTANCE                           = 7.425150e+08
SUB_SOLAR_LATITUDE                       = 2.772
SUB_SOLAR_LONGITUDE                      = 58.878
SUB_SOLAR_AZIMUTH                        = 176.873
INCIDENCE_ANGLE                          = 79.139
EMISSION_ANGLE                           = 39.021
PHASE_ANGLE                              = 40.260
LOCAL_HOUR_ANGLE                         = 252.310
INTERCEPT_POINT_LATITUDE                 = 0.027
INTERCEPT_POINT_LONGITUDE                = 339.750
INTERCEPT_POINT_LINE                     = 400.0
INTERCEPT_POINT_LINE_SAMPLE              = 400.0

/* Target radii */
A_AXIS_RADIUS                            = 1.565000e+03
B_AXIS_RADIUS                            = 1.565000e+03
C_AXIS_RADIUS                            = 1.565000e+03

/* Processing parameters */
MEAN_RADIANCE                            = N/A
MEAN_REFLECTANCE                         = N/A
REFLECTANCE_SCALING_FACTOR               = N/A
RADIANCE_SCALING_FACTOR                  = N/A
UNEVEN_BIT_WEIGHT_CORR_FLAG              = N/A
DARK_CURRENT_FILE_NAME                   = N/A
SLOPE_FILE_NAME                          = N/A
BLEMISH_FILE_NAME                        = N/A
SHUTTER_OFFSET_FILE_NAME                 = N/A
DATA_TYPE                                = LSB_UNSIGNED_INTEGER
SOURCE_PRODUCT_ID                        = (S991130A.BSP, S000105A.BSP, N/A,
                                            MIPS_NEAR.CK, NULL)
PROCESSING_HISTORY_TEXT                  = "VICAR programs run:
                                            SSIMERGE,CATLABEL,BADLABELS."
PRODUCT_TYPE                             = REDR

/* ICT or Lossless compression */
ENCODING_COMPRESSION_RATIO               = 3.410
ENCODING_MIN_COMPRESSION_RATIO           = 2.517
ENCODING_MAX_COMPRESSION_RATIO           = 4.791
HUFFMAN_TABLE_TYPE                       = SKEWED
ICT_DESPIKE_THRESHOLD                    = 255
CUT_OUT_WINDOW                           = (1, 1, 800, 800)
TRUTH_WINDOW                             = (801, 801, 96, 96)
PRODUCT_VERSION_ID                       = 0
ICT_QUANTIZATION_STEP_SIZE               = 5
ICT_ZIGZAG_PATTERN                       = ZIGZAG
CMPRS_QUANTZ_TBL_ID                      = UNIFORM

/* VICAR IMAGE HEADER Object */
Object = IMAGE_HEADER
  INTERCHANGE_FORMAT = BINARY
  HEADER_TYPE        = VICAR2
  BYTES              = 2000
  RECORDS            = 2
  ^DESCRIPTION       = VICAR2.TXT
End_Object

/* Table Object (for telemetry table) */
Object = TELEMETRY_TABLE
  INTERCHANGE_FORMAT = BINARY
  ROWS               = 1
  COLUMNS            = 86
  ROW_BYTES          = 1800
  ^STRUCTURE         = RTLMTAB.FMT
End_Object

/* Bad Data Value Header Object */
Object = BAD_DATA_VALUES_HEADER
  HEADER_TYPE        = BDV
  INTERCHANGE_FORMAT = BINARY
  BYTES              = 8000
  RECORDS            = 8
  ^DESCRIPTION       = BADDATA.TXT
End_Object

/* Image Object */
Object = IMAGE
  LINES                  = 800
  LINE_SAMPLES           = 800
  SAMPLE_BITS            = 8
  SAMPLE_TYPE            = UNSIGNED_INTEGER
  INVALID_CONSTANT       = N/A
  LINE_PREFIX_BYTES      = 200
  ^LINE_PREFIX_STRUCTURE = RLINEPRX.FMT
End_Object
EndObject = gllssi2isis
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2019-04-16
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:34:22
  HostName          = Unknown
  UserName          = imishra
  Description       = "Import a Galileo solid state imager (SSI) image EDR
                       into Isis cube format"

  Group = UserParameters
    FROM      = "All data files/6439r.lbl"
    TO        = "All data files/Post ISIS/6439r.cub"
    FRAMEMODE = AUTO
  End_Group
End_Object

Object = spiceinit
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-08-10
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:34:23
  HostName          = Unknown
  UserName          = imishra
  Description       = "Update SPICE data (kernels, pointing, and position) for
                       a camera cube"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/6439r.cub"
    WEB          = false
    ATTACH       = TRUE
    CKSMITHED    = FALSE
    CKRECON      = TRUE
    CKPREDICTED  = FALSE
    CKNADIR      = FALSE
    SPKSMITHED   = FALSE
    SPKRECON     = TRUE
    SPKPREDICTED = FALSE
    SHAPE        = SYSTEM
    STARTPAD     = 0.0
    ENDPAD       = 0.0
    URL          = https://services.isis.astrogeology.usgs.gov/cgi-bin/spicei-
                   nit.cgi
    PORT         = 443
  End_Group
End_Object

Object = gllssical
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-02-23
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:34:24
  HostName          = Unknown
  UserName          = imishra
  Description       = "Perform Radiometric correction on GALILEO-SSI Imaging"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/6439r.cub"
    TO           = "All data files/Post ISIS/6439r_cal.cub"
    UNITS        = IOF
    SCALE        = 1.0
    BITWEIGHTING = false
  End_Group
End_Object
