&ÀÃõ4ì˜ÚÀn)ï|ý3HÁCCSD3ZF0000100000001NJPL3IF0PDS200000001 = SFDU_LABEL

/* File Format and Length */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 1000
FILE_RECORDS                             = 808

/* Pointers to Data Objects */
^IMAGE_HEADER                            = (6314R.IMG, 1)
^TELEMETRY_TABLE                         = (6314R.IMG, 3)
^BAD_DATA_VALUES_HEADER                  = (6314R.IMG, 5)
^IMAGE                                   = (6314R.IMG, 9)
^LINE_PREFIX_TABLE                       = (6314R.IMG, 9)

/* Description/Catalog Keywords */
DATA_SET_ID                              = GO-J/JSA-SSI-2-REDR-V1.0
SPACECRAFT_NAME                          = "GALILEO ORBITER"
INSTRUMENT_NAME                          = "SOLID STATE IMAGING SYSTEM"

/* Time tags and observation descriptors */
SPACECRAFT_CLOCK_CNT_PARTITION           = 1
SPACECRAFT_CLOCK_START_COUNT             = 05272863.14
IMAGE_TIME                               = 1999-11-25T18:46:28.841Z
IMAGE_ID                                 = 25E0021
ORBIT_NUMBER                             = 25
OBSERVATION_ID                           = 25ESGLOBAL01
TARGET_NAME                              = EUROPA
NTV_TIME_FROM_CLOSEST_APPROACH           = -000T07:22:32Z
NTV_SAT_TIME_FROM_CLOSEST_APRH           = 000T02:18:23Z
NOTE                                     = "NOT APPLICABLE"

/* Camera and spacecraft state parameters */
FILTER_NAME                              = CLEAR
FILTER_NUMBER                            = 0
EXPOSURE_DURATION                        = 6.25
GAIN_MODE_ID                             = 100K
FRAME_DURATION                           = 8.667
LIGHT_FLOOD_STATE_FLAG                   = ON
EXPOSURE_TYPE                            = NORMAL
BLEMISH_PROTECTION_FLAG                  = OFF
INVERTED_CLOCK_STATE_FLAG                = "NOT INVERTED"
ON_CHIP_MOSAIC_FLAG                      = N
COMPRESSION_TYPE                         = "INTEGER COSINE TRANSFORM"
ENTROPY                                  = 4.734
TELEMETRY_FORMAT_ID                      = IM8
OBSTRUCTION_ID                           = "NOT POSSIBLE"
INSTRUMENT_MODE_ID                       = N/A

/* Viewing Geometry                                           */
/* Note: These viewing geometry parameters are best estimates */
/* at the time this picture label was generated.              */
POSITIVE_LONGITUDE_DIRECTION             = WEST

/* Spacecraft Geometry */
TARGET_CENTER_DISTANCE                   = 9.560227e+04
CENTRAL_BODY_DISTANCE                    = 5.864777e+05
SUB_SPACECRAFT_LATITUDE                  = 4.369
SUB_SPACECRAFT_LONGITUDE                 = 17.923
SUB_SPACECRAFT_LINE                      = -56.278
SUB_SPACECRAFT_LINE_SAMPLE               = 1493.275
SUB_SPACECRAFT_AZIMUTH                   = 355.380

/* Camera and Lighting Geometry                                  */
/* Resolution of HORIZONTAL_PIXEL_SCALE,                         */
/* VERTICAL_PIXEL_SCALE, and SLANT_DISTANCE                      */
/* is calculated from the light source values in                 */
/* INTERCEPT_POINT_LATITUDE, INTERCEPT_POINT_LONGITUDE,          */
/* INTERCEPT_POINT_LINE and INTERCEPT_POINT_LINE_SAMPLE keywords */
/* If the target is a Ring keyword RING_RADIUS                   */
/* is substituted for INTERCEPT_POINT_LATITUDE                   */
/* If the TARGET_NAME = J RINGS, viewing geometry was            */
/* calculated using Jupiter as the target.                       */
TWIST_ANGLE                              = 279.268
CONE_ANGLE                               = 131.391
RIGHT_ASCENSION                          = 73.475
DECLINATION                              = 19.706
NORTH_AZIMUTH                            = 266.852
SMEAR_AZIMUTH                            = UNK
SMEAR_MAGNITUDE                          = UNK
HORIZONTAL_PIXEL_SCALE                   = 1.058720e+03
VERTICAL_PIXEL_SCALE                     = 9.570320e+02
SLANT_DISTANCE                           = 9.418800e+04
SOLAR_DISTANCE                           = 7.425160e+08
SUB_SOLAR_LATITUDE                       = 2.772
SUB_SOLAR_LONGITUDE                      = 58.786
SUB_SOLAR_AZIMUTH                        = 177.547
INCIDENCE_ANGLE                          = 15.664
EMISSION_ANGLE                           = 25.557
PHASE_ANGLE                              = 41.215
LOCAL_HOUR_ANGLE                         = 194.073
INTERCEPT_POINT_LATITUDE                 = 3.264
INTERCEPT_POINT_LONGITUDE                = 43.108
INTERCEPT_POINT_LINE                     = 0.2
INTERCEPT_POINT_LINE_SAMPLE              = 800.8

/* Target radii */
A_AXIS_RADIUS                            = 1.565000e+03
B_AXIS_RADIUS                            = 1.565000e+03
C_AXIS_RADIUS                            = 1.565000e+03

/* Processing parameters */
MEAN_RADIANCE                            = N/A
MEAN_REFLECTANCE                         = N/A
REFLECTANCE_SCALING_FACTOR               = N/A
RADIANCE_SCALING_FACTOR                  = N/A
UNEVEN_BIT_WEIGHT_CORR_FLAG              = N/A
DARK_CURRENT_FILE_NAME                   = N/A
SLOPE_FILE_NAME                          = N/A
BLEMISH_FILE_NAME                        = N/A
SHUTTER_OFFSET_FILE_NAME                 = N/A
DATA_TYPE                                = LSB_UNSIGNED_INTEGER
SOURCE_PRODUCT_ID                        = (S000105A.BSP, S000105A.BSP, N/A,
                                            MIPS_NAV.CK, NULL)
PROCESSING_HISTORY_TEXT                  = "VICAR programs run:
                                            SSIMERGE,CATLABEL,BADLABELS."
PRODUCT_TYPE                             = REDR

/* ICT or Lossless compression */
ENCODING_COMPRESSION_RATIO               = 3.479
ENCODING_MIN_COMPRESSION_RATIO           = 2.213
ENCODING_MAX_COMPRESSION_RATIO           = 5.091
HUFFMAN_TABLE_TYPE                       = SKEWED
ICT_DESPIKE_THRESHOLD                    = 255
CUT_OUT_WINDOW                           = (1, 1, 800, 800)
TRUTH_WINDOW                             = (801, 801, 96, 96)
PRODUCT_VERSION_ID                       = 1
ICT_QUANTIZATION_STEP_SIZE               = 6
ICT_ZIGZAG_PATTERN                       = ZIGZAG
CMPRS_QUANTZ_TBL_ID                      = UNIFORM

/* VICAR IMAGE HEADER Object */
Object = IMAGE_HEADER
  INTERCHANGE_FORMAT = BINARY
  HEADER_TYPE        = VICAR2
  BYTES              = 2000
  RECORDS            = 2
  ^DESCRIPTION       = VICAR2.TXT
End_Object

/* Table Object (for telemetry table) */
Object = TELEMETRY_TABLE
  INTERCHANGE_FORMAT = BINARY
  ROWS               = 1
  COLUMNS            = 86
  ROW_BYTES          = 1800
  ^STRUCTURE         = RTLMTAB.FMT
End_Object

/* Bad Data Value Header Object */
Object = BAD_DATA_VALUES_HEADER
  HEADER_TYPE        = BDV
  INTERCHANGE_FORMAT = BINARY
  BYTES              = 4000
  RECORDS            = 4
  ^DESCRIPTION       = BADDATA.TXT
End_Object

/* Image Object */
Object = IMAGE
  LINES                  = 800
  LINE_SAMPLES           = 800
  SAMPLE_BITS            = 8
  SAMPLE_TYPE            = UNSIGNED_INTEGER
  INVALID_CONSTANT       = N/A
  LINE_PREFIX_BYTES      = 200
  ^LINE_PREFIX_STRUCTURE = RLINEPRX.FMT
End_Object
EndObject = gllssi2isis
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2019-04-16
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:34
  HostName          = Unknown
  UserName          = imishra
  Description       = "Import a Galileo solid state imager (SSI) image EDR
                       into Isis cube format"

  Group = UserParameters
    FROM      = "All data files/6314r.lbl"
    TO        = "All data files/Post ISIS/6314r.cub"
    FRAMEMODE = AUTO
  End_Group
End_Object

Object = spiceinit
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-08-10
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:35
  HostName          = Unknown
  UserName          = imishra
  Description       = "Update SPICE data (kernels, pointing, and position) for
                       a camera cube"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/6314r.cub"
    WEB          = false
    ATTACH       = TRUE
    CKSMITHED    = FALSE
    CKRECON      = TRUE
    CKPREDICTED  = FALSE
    CKNADIR      = FALSE
    SPKSMITHED   = FALSE
    SPKRECON     = TRUE
    SPKPREDICTED = FALSE
    SHAPE        = SYSTEM
    STARTPAD     = 0.0
    ENDPAD       = 0.0
    URL          = https://services.isis.astrogeology.usgs.gov/cgi-bin/spicei-
                   nit.cgi
    PORT         = 443
  End_Group
End_Object

Object = gllssical
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-02-23
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:36
  HostName          = Unknown
  UserName          = imishra
  Description       = "Perform Radiometric correction on GALILEO-SSI Imaging"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/6314r.cub"
    TO           = "All data files/Post ISIS/6314r_cal.cub"
    UNITS        = IOF
    SCALE        = 1.0
    BITWEIGHTING = false
  End_Group
End_Object

Object = phocube
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-06-01
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:33:37
  HostName          = Unknown
  UserName          = imishra
  Description       = "Create photometric and geometric information bands for
                       an image cube"

  Group = UserParameters
    FROM                       = "All data files/Post ISIS/6314r_cal.cub"
    TO                         = "All data files/Post ISIS/6314r_cal.pho.cub"
    SOURCE                     = CAMERA
    SPECIALPIXELS              = TRUE
    DN                         = yes
    ALLDNS                     = FALSE
    PHASE                      = yes
    EMISSION                   = yes
    INCIDENCE                  = yes
    LOCALEMISSION              = FALSE
    LOCALINCIDENCE             = FALSE
    LATITUDE                   = yes
    LONGITUDE                  = yes
    PIXELRESOLUTION            = yes
    LINERESOLUTION             = FALSE
    SAMPLERESOLUTION           = FALSE
    DETECTORRESOLUTION         = FALSE
    OBLIQUEDETECTORRESOLUTION  = FALSE
    NORTHAZIMUTH               = FALSE
    SUNAZIMUTH                 = FALSE
    SPACECRAFTAZIMUTH          = FALSE
    OFFNADIRANGLE              = FALSE
    SLOPE                      = FALSE
    LOCALNORMAL                = FALSE
    ELLIPSOIDNORMAL            = FALSE
    SUBSPACECRAFTGROUNDAZIMUTH = FALSE
    SUBSOLARGROUNDAZIMUTH      = FALSE
    MORPHOLOGYRANK             = FALSE
    ALBEDORANK                 = FALSE
    RADEC                      = FALSE
    BODYFIXED                  = FALSE
    LOCALTIME                  = FALSE
  End_Group
End_Object
