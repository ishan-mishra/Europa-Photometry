  ProgramVersion    = 2021-08-10
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:34:18
  HostName          = Unknown
  UserName          = imishra
  Description       = "Update SPICE data (kernels, pointing, and position) for
                       a camera cube"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/6427r.cub"
    WEB          = false
    ATTACH       = TRUE
    CKSMITHED    = FALSE
    CKRECON      = TRUE
    CKPREDICTED  = FALSE
    CKNADIR      = FALSE
    SPKSMITHED   = FALSE
    SPKRECON     = TRUE
    SPKPREDICTED = FALSE
    SHAPE        = SYSTEM
    STARTPAD     = 0.0
    ENDPAD       = 0.0
    URL          = https://services.isis.astrogeology.usgs.gov/cgi-bin/spicei-
                   nit.cgi
    PORT         = 443
  End_Group
End_Object

Object = gllssical
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-02-23
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:34:19
  HostName          = Unknown
  UserName          = imishra
  Description       = "Perform Radiometric correction on GALILEO-SSI Imaging"

  Group = UserParameters
    FROM         = "All data files/Post ISIS/6427r.cub"
    TO           = "All data files/Post ISIS/6427r_cal.cub"
    UNITS        = IOF
    SCALE        = 1.0
    BITWEIGHTING = false
  End_Group
End_Object

Object = phocube
  IsisVersion       = "8.0.1  | 2023-08-25"
  ProgramVersion    = 2021-06-01
  ProgramPath       = /Users/imishra/opt/miniconda3/envs/isis/bin
  ExecutionDateTime = 2025-04-29T20:34:20
  HostName          = Unknown
  UserName          = imishra
  Description       = "Create photometric and geometric information bands for
                       an image cube"

  Group = UserParameters
    FROM                       = "All data files/Post ISIS/6427r_cal.cub"
    TO                         = "All data files/Post ISIS/6427r_cal.pho.cub"
    SOURCE                     = CAMERA
    SPECIALPIXELS              = TRUE
    DN                         = yes
    ALLDNS                     = FALSE
    PHASE                      = yes
    EMISSION                   = yes
    INCIDENCE                  = yes
    LOCALEMISSION              = FALSE
    LOCALINCIDENCE             = FALSE
    LATITUDE                   = yes
    LONGITUDE                  = yes
    PIXELRESOLUTION            = yes
    LINERESOLUTION             = FALSE
    SAMPLERESOLUTION           = FALSE
    DETECTORRESOLUTION         = FALSE
    OBLIQUEDETECTORRESOLUTION  = FALSE
    NORTHAZIMUTH               = FALSE
    SUNAZIMUTH                 = FALSE
    SPACECRAFTAZIMUTH          = FALSE
    OFFNADIRANGLE              = FALSE
    SLOPE                      = FALSE
    LOCALNORMAL                = FALSE
    ELLIPSOIDNORMAL            = FALSE
    SUBSPACECRAFTGROUNDAZIMUTH = FALSE
    SUBSOLARGROUNDAZIMUTH      = FALSE
    MORPHOLOGYRANK             = FALSE
    ALBEDORANK                 = FALSE
    RADEC                      = FALSE
    BODYFIXED                  = FALSE
    LOCALTIME                  = FALSE
  End_Group
End_Object
